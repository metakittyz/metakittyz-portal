# Optional. Only needed for the natural (OpenAI) guide voice.
# Without it the app still works — the guide falls back to your device's
# built-in speech synthesis, which is free and offline but more robotic.
#
# Get a key: https://platform.openai.com/api-keys
# This is a paid API key, billed per character of speech generated.
# Every line is cached after its first generation, so you pay once per line.
OpenAI_EternalRuler=sk-...

# OPENAI_API_KEY is also accepted, if you'd rather use the conventional name.
